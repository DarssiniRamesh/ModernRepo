# Spring Boot Profile Configuration
# Set to 'prod' to use PostgreSQL, 'dev' to use H2 in-memory database
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Database Connection (for prod profile)
# These defaults match the postgres-db container configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123

# Spring Boot Datasource Configuration
# Can be set explicitly or will be constructed from POSTGRES_* variables above
SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# Optional: Override Hibernate DDL behavior (default: update)
# SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Application URLs and CORS settings
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_MAX_AGE=3600

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Additional Configuration
TRUST_PROXY=true
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX=100
